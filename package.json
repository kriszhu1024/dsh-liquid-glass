{
  "name": "dsh-liquid-glass",
  "version": "0.3.1",
  "type": "module",
  "description": "Apple-style liquid-glass surfaces for the DeepSeek Harness Web UI, with a live control panel: translucent window chrome, a frosted composer with a lit edge, a specular window rim, and iMessage-style user bubbles.",
  "license": "MIT",
  "author": "kriszhu1024 (https://github.com/kriszhu1024)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "theme",
    "liquid-glass",
    "vibrancy",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriszhu1024/dsh-liquid-glass.git"
  },
  "homepage": "https://github.com/kriszhu1024/dsh-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/kriszhu1024/dsh-liquid-glass/issues"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
